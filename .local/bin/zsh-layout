#!/usr/bin/env bash
# NAME
#     zsh-layout — session tmux décrite par un fichier de disposition
#
# SYNOPSIS
#     zsh-layout -l DISPOSITION [-p PROFIL] [-s SESSION] [-D] [-n]
#     zsh-layout -h | --help
#
# DESCRIPTION
#     Crée une session tmux dont chaque fenêtre s'ouvre dans son propre
#     répertoire, puis s'y rattache. Les fenêtres sont lues dans le fichier
#     ~/.config/zsh-layouts/DISPOSITION.conf (voir FORMAT ci-dessous).
#
#     Si la session existe déjà, elle est reprise telle quelle : aucune
#     fenêtre n'est ajoutée ni déplacée, et le fichier de disposition n'est
#     même pas relu. Lancé depuis l'intérieur de tmux, le script bascule vers
#     la session au lieu d'imbriquer un second tmux.
#
#     Chaque shell démarre avec le profil zsh demandé (variable ZSH_PROFILE),
#     comme le fait « zenv ». Ne remplace pas « zsh-daily » : celui-ci ouvre la
#     session « main » dans le répertoire courant, sans disposition imposée.
#
#     Des alias (zsh-projets, zsh-cours) sont définis dans
#     ~/.shellrc/rc.d/zenv.sh : ils appellent ce script avec la disposition
#     correspondante.
#
# FORMAT
#     Une ligne par fenêtre : « numéro|nom|répertoire ». La première ligne est
#     la fenêtre active à l'arrivée dans la session. Les lignes vides et celles
#     qui commencent par « # » sont ignorées. Un « ~ » ou « ~/ » initial dans
#     le répertoire est remplacé par $HOME. Le nom et le répertoire ne doivent
#     pas contenir « | ».
#
#         # ~/.config/zsh-layouts/cours.conf
#         1|projets|~/projets
#         2|astro|~/projets/cours_astro
#
# OPTIONS
#     -l, --layout NOM       Disposition à ouvrir (obligatoire) : nom d'un
#                            fichier ~/.config/zsh-layouts/NOM.conf (lettres,
#                            chiffres, _ et -).
#     -p, --profile PROFIL   Profil zsh des fenêtres (défaut : simple).
#     -s, --session NOM      Nom de la session tmux (défaut : le nom de la
#                            disposition ; lettres, chiffres, _ et -).
#     -D, --detach           Détache d'abord les autres clients déjà attachés
#                            à la session (reprise d'une session restée
#                            ouverte ailleurs).
#     -n, --no-attach        Crée la session sans s'y rattacher.
#     -h, --help             Affiche cette aide.
#
# EXAMPLES
#     # Ouvrir (ou reprendre) la session « cours »
#     zsh-layout --layout cours
#
#     # Autre profil zsh
#     zsh-layout -l projets -p omz
#
#     # Préparer la session en arrière-plan, s'y rattacher plus tard
#     zsh-layout -l cours --no-attach
#
# EXIT CODES
#     0   Session créée ou reprise, puis quittée normalement.
#     1   Erreur d'exécution : tmux absent, disposition introuvable ou mal
#         formée, répertoire introuvable, profil inconnu, échec de tmux.
#     2   Erreur d'usage : option inconnue, valeur manquante, disposition
#         absente, nom de disposition, de profil ou de session invalide.
set -euo pipefail

# -----------------------------------------------------------------------------
# Constantes
# -----------------------------------------------------------------------------
readonly DEFAULT_PROFILE="simple"
readonly LAYOUTS_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/zsh-layouts"

# -----------------------------------------------------------------------------
# Couleurs et fonctions de log
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { echo -e "${CYAN}[INFO]${RESET}      $*"; }
success() { echo -e "${GREEN}[OK]${RESET}        $*"; }
warn()    { echo -e "${YELLOW}[ATTENTION]${RESET} $*"; }
error()   { echo -e "${RED}[ERREUR]${RESET}    $*" >&2; }
die()     { error "$*"; exit 1; }

usage() {
    # Réimprime l'en-tête manpage sans le préfixe « # ».
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}
usage_error() { error "$*"; echo "Essayez : $(basename "$0") --help" >&2; exit 2; }

# -----------------------------------------------------------------------------
# Arguments
# -----------------------------------------------------------------------------
LAYOUT=""
PROFILE="$DEFAULT_PROFILE"
SESSION=""
DETACH=0
ATTACH=1

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--layout)
                [[ -n "${2:-}" ]] || usage_error "$1 attend une valeur."
                LAYOUT="$2"; shift 2 ;;
            -p|--profile)
                [[ -n "${2:-}" ]] || usage_error "$1 attend une valeur."
                PROFILE="$2"; shift 2 ;;
            -s|--session)
                [[ -n "${2:-}" ]] || usage_error "$1 attend une valeur."
                SESSION="$2"; shift 2 ;;
            -D|--detach)    DETACH=1; shift ;;
            -n|--no-attach) ATTACH=0; shift ;;
            -h|--help)      usage; exit 0 ;;
            *) usage_error "Option inconnue : $1" ;;
        esac
    done

    [[ -n "$LAYOUT" ]] || usage_error "La disposition est obligatoire (-l NOM)."
    # La session reprend le nom de la disposition tant que -s n'est pas donné.
    [[ -n "$SESSION" ]] || SESSION="$LAYOUT"

    # La disposition et le profil servent à fabriquer un nom de fichier, la
    # session un nom tmux (qui interdit « . » et « : ») : on restreint à des
    # caractères sûrs, ce qui exclut aussi « / » et « .. » dans les noms.
    [[ "$LAYOUT" =~ ^[A-Za-z0-9_-]+$ ]] \
        || usage_error "Nom de disposition invalide : $LAYOUT"
    [[ "$PROFILE" =~ ^[A-Za-z0-9._-]+$ ]] \
        || usage_error "Nom de profil invalide : $PROFILE"
    [[ "$SESSION" =~ ^[A-Za-z0-9_-]+$ ]] \
        || usage_error "Nom de session invalide : $SESSION"
}

# -----------------------------------------------------------------------------
# Disposition
# -----------------------------------------------------------------------------
# Une entrée par fenêtre : « numéro|nom|répertoire », remplie par load_layout.
WINDOWS=()

list_layouts() {
    local f names=()
    for f in "${LAYOUTS_DIR}"/*.conf; do
        [[ -e "$f" ]] && names+=("$(basename "$f" .conf)")
    done
    echo "${names[*]:-aucune}"
}

# Lit ~/.config/zsh-layouts/NOM.conf dans WINDOWS, en validant chaque ligne :
# mieux vaut échouer ici que créer une session à moitié construite.
load_layout() {
    local file="${LAYOUTS_DIR}/${LAYOUT}.conf"
    local line num name dir lineno=0 seen=" "

    [[ -f "$file" ]] \
        || die "Disposition '${LAYOUT}' introuvable : ${file} (disponibles : $(list_layouts))."

    # « || [[ -n "$line" ]] » traite aussi une dernière ligne sans saut de ligne.
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        # Espaces de tête et de queue, puis lignes vides et commentaires.
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* ]] && continue

        IFS='|' read -r num name dir <<< "$line"
        [[ "$num" =~ ^[0-9]+$ ]] \
            || die "${file}:${lineno} : numéro de fenêtre invalide : « ${num} »."
        [[ -n "$name" && -n "$dir" ]] \
            || die "${file}:${lineno} : attendu « numéro|nom|répertoire »."
        [[ "$dir" != *"|"* ]] \
            || die "${file}:${lineno} : « | » interdit dans le répertoire."
        [[ "$seen" != *" ${num} "* ]] \
            || die "${file}:${lineno} : numéro de fenêtre ${num} en double."
        seen+="${num} "

        # Seul le « ~ » initial est développé (pas de $VAR ni de commande).
        case "$dir" in
            "~")   dir="$HOME" ;;
            "~/"*) dir="${HOME}/${dir#"~/"}" ;;
        esac
        WINDOWS+=("${num}|${name}|${dir}")
    done < "$file"

    [[ "${#WINDOWS[@]}" -gt 0 ]] || die "${file} : aucune fenêtre définie."
}

# -----------------------------------------------------------------------------
# Vérifications préalables
# -----------------------------------------------------------------------------
check_prerequisites() {
    command -v tmux >/dev/null 2>&1 || die "tmux n'est pas installé."

    # Mêmes règles que zenv : base, light et omz n'ont pas de fichier p10k.
    case "$PROFILE" in
        base|light|omz) ;;
        *)
            [[ -f "${HOME}/.zsh/powerlevel10k/p10k.zsh.${PROFILE}" ]] \
                || die "Profil '${PROFILE}' introuvable (utilisez « zenv » pour la liste)."
            ;;
    esac
}

# tmux remplace silencieusement un répertoire inexistant par $HOME :
# on préfère échouer plutôt que d'ouvrir une fenêtre au mauvais endroit.
check_directories() {
    local entry dir
    for entry in "${WINDOWS[@]}"; do
        dir="${entry##*|}"
        [[ -d "$dir" ]] || die "Répertoire introuvable : ${dir}"
    done
}

# Vrai si tmux >= 3.2 : new-session accepte alors -e VAR=val, qui fixe le profil
# même quand le serveur tmux tourne déjà (même test que dans zenv.sh).
tmux_has_env_flag() {
    local v major minor
    v="$(tmux -V | sed 's/[^0-9.]//g')"
    major="${v%%.*}"
    minor="${v#*.}"
    [[ "$minor" != "$v" ]] || minor=0
    [[ -n "$major" ]] || return 1
    [[ "$major" -gt 3 ]] || { [[ "$major" -eq 3 && "${minor:-0}" -ge 2 ]]; }
}

# -----------------------------------------------------------------------------
# Création de la session
# -----------------------------------------------------------------------------
# Détruit la session à moitié construite puis quitte : sans cela, un second
# lancement la reprendrait « telle quelle » avec des fenêtres manquantes.
rollback_die() {
    tmux kill-session -t "=${SESSION}" 2>/dev/null || true
    die "$*"
}

create_session() {
    local entry rest num name dir first_index first=1
    local new_args

    for entry in "${WINDOWS[@]}"; do
        num="${entry%%|*}"
        rest="${entry#*|}"
        name="${rest%%|*}"
        dir="${rest#*|}"

        if [[ "$first" -eq 1 ]]; then
            # -d : crée sans s'attacher. -c : répertoire de la fenêtre, et
            # répertoire de départ par défaut des fenêtres suivantes (écrasé
            # ci-dessous par -c de chaque new-window).
            new_args=(new-session -d -s "$SESSION" -n "$name" -c "$dir")
            tmux_has_env_flag && new_args+=(-e "ZSH_PROFILE=${PROFILE}")
            # ZSH_PROFILE en préfixe : suffit au premier démarrage du serveur
            # tmux ; -e couvre le cas d'un serveur déjà lancé.
            TERM=xterm-256color ZSH_PROFILE="$PROFILE" tmux "${new_args[@]}" \
                || die "Création de la session '${SESSION}' impossible."

            # La première fenêtre prend l'index base-index de la config tmux
            # (0 par défaut) : on la renumérote pour coller à la disposition.
            first_index="$(tmux list-windows -t "=${SESSION}" -F '#{window_index}' | head -n1)"
            if [[ "$first_index" != "$num" ]]; then
                tmux move-window -s "=${SESSION}:${first_index}" -t "=${SESSION}:${num}" \
                    || rollback_die "Renumérotation de la fenêtre '${name}' impossible."
            fi
            first=0
            FIRST_WINDOW="$num"
        else
            tmux new-window -t "=${SESSION}:${num}" -n "$name" -c "$dir" \
                || rollback_die "Création de la fenêtre ${num} '${name}' impossible."
        fi
    done

    tmux select-window -t "=${SESSION}:${FIRST_WINDOW}" \
        || rollback_die "Sélection de la fenêtre ${FIRST_WINDOW} impossible."
}

# -----------------------------------------------------------------------------
# Rattachement
# -----------------------------------------------------------------------------
attach_session() {
    if [[ -n "${TMUX:-}" ]]; then
        # Déjà dans tmux : imbriquer est déconseillé, on bascule.
        tmux switch-client -t "=${SESSION}"
    elif [[ "$DETACH" -eq 1 ]]; then
        # -d : détache les autres clients (reprise depuis une autre machine).
        TERM=xterm-256color exec tmux attach-session -d -t "=${SESSION}"
    else
        TERM=xterm-256color exec tmux attach-session -t "=${SESSION}"
    fi
}

# -----------------------------------------------------------------------------
# Point d'entrée
# -----------------------------------------------------------------------------
FIRST_WINDOW=""

main() {
    parse_args "$@"
    check_prerequisites

    # « = » : correspondance exacte du nom, sinon tmux accepte un préfixe
    # (« projets » reprendrait « projets2 »).
    if tmux has-session -t "=${SESSION}" 2>/dev/null; then
        info "Session '${SESSION}' déjà ouverte : reprise telle quelle."
    else
        load_layout
        check_directories
        create_session
        success "Session '${SESSION}' créée (disposition ${BOLD}${LAYOUT}${RESET}, ${#WINDOWS[@]} fenêtre(s), profil ${BOLD}${PROFILE}${RESET})."
    fi

    if [[ "$ATTACH" -eq 1 ]]; then
        attach_session
    fi
}

main "$@"
