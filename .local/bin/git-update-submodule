#!/usr/bin/env bash

# Vérification du nombre d'arguments
if [ "$#" -ne 2 ]; then
    echo "Usage: git update-submodule <chemin_du_submodule> <tag>"
    exit 1
fi

# Suppression de l'éventuel slash final saisi par l'autocomplétion
SUB_PATH="${1%/}"
TARGET_TAG="$2"

# 1. Vérification de l'existence du submodule dans la configuration
if ! git config --file .gitmodules --get-regexp path | grep -q "$SUB_PATH"; then
    echo "Erreur : « $SUB_PATH » n'est pas un submodule valide dans .gitmodules."
    exit 1
fi

# 2. Initialisation si le répertoire est vide
git submodule update --init "$SUB_PATH" || { 
    echo "Erreur : Impossible d'initialiser « $SUB_PATH »."
    exit 1
}

# 3. Récupération des étiquettes distantes
git -C "$SUB_PATH" fetch --tags || { 
    echo "Erreur : Échec du fetch réseau sur « $SUB_PATH »."
    exit 1
}

# 4. Vérification stricte de l'existence du tag
if ! git -C "$SUB_PATH" rev-parse "refs/tags/$TARGET_TAG" >/dev/null 2>&1; then
    echo "Erreur : Le tag « $TARGET_TAG » n'existe pas dans le dépôt distant du submodule."
    exit 1
fi

# 5. Basculement sur le tag (en mode tête détachée)
git -C "$SUB_PATH" checkout "$TARGET_TAG" || { 
    echo "Erreur : Échec du checkout sur « $TARGET_TAG »."
    exit 1
}

# 6. Ajout automatique à l'index du dépôt parent
git add "$SUB_PATH"
echo "Succès : « $SUB_PATH » mis à jour sur « $TARGET_TAG » et ajouté à l'index."