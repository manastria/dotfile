# -*- mode: shell-script -*-
# Profil "light" : sans oh-my-zsh, sans powerlevel10k
# Prompt : pure | Plugins : zsh-autosuggestions + zsh-syntax-highlighting

PLUGIN_DIR="$HOME/.zsh/custom/plugins"

# --- Prompt Pure ---
# On ajoute le dossier de Pure au fpath de ZSH
fpath+=$PLUGIN_DIR/pure

autoload -U promptinit; promptinit
prompt pure

# --- Completion ---
autoload -U compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' cache-path "${HOME}/.zsh/cache"
zstyle ':completion::complete:*' use-cache on

# 1. Activer le regroupement des éléments par type
zstyle ':completion:*' group-name ''

# 2. Définir le format d'affichage des en-têtes de groupe
# %d est remplacé dynamiquement par la description du groupe
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

zstyle ':completion:*:options' description 'yes'
zstyle ':completion:*:options' auto-description '%d'

zstyle ':completion:*' list-separator '-->'

# --- Options essentielles ---
setopt auto_cd
setopt autopushd pushdminus pushdsilent pushdignoredups
setopt extended_glob glob_dots
setopt correct
setopt complete_in_word always_to_end
unsetopt beep hist_beep list_beep

# --- Keybindings (emacs) ---
bindkey -e
bindkey '\e[1;5C' forward-word            # Ctrl+Droite
bindkey '\e[1;5D' backward-word           # Ctrl+Gauche
bindkey '\e[2~'   overwrite-mode          # Inser
bindkey '\e[3~'   delete-char             # Suppr
bindkey '\e[5~'   history-search-backward # PgUp
bindkey '\e[6~'   history-search-forward  # PgDn
autoload -U edit-command-line
zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

# --- Chargement des Plugins ---
source "$PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"


# --- Zoxide ---
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# --- Titre de fenêtre (compatible iTerm2/WezTerm) ---
_light_precmd_title() {
    echo -n "\x1b]1337;CurrentDir=$(pwd)\x07"
    print -Pn "\e]0;%m: %~\a"
}
precmd_functions+=(_light_precmd_title)
