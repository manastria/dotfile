set -g  display-panes-active-colour blue
set -g  display-panes-colour green
set -g  message-command-style "fg=default,bg=default"
set -g  message-style "fg=default,bg=default"
# set -g  status-interval 1
set -g  status-justify centre
set -g  status-left "#S #[fg=white]» #[fg=yellow]#I #[fg=cyan]#P #[fg=white]» "
set -g  status-left-length 40
set -g  status-left-style "fg=green,bg=colour236"
set -g  status-right "#H "
set -g  status-right-length 40
set -g  status-right-style "fg=cyan,bg=colour236"
set -g  status-style "fg=cyan,bg=colour236"
set -gw clock-mode-colour red
set -gw clock-mode-style 24
set -gw mode-style "fg=default,bg=red"

# Séparation des panneaux : trait épais (━ au lieu de ─) pour ne pas se confondre
# avec les filets fins du prompt, inactif gris foncé, actif magenta (couleur absente
# du prompt, qui utilise bleu/vert/jaune/cyan).
set -gw pane-border-lines heavy
set -gw pane-border-style "fg=colour240,bg=default"
set -gw pane-active-border-style "fg=magenta,bg=default"
set -gw window-status-activity-style "fg=yellow,bg=colour236"

set -gw window-status-current-format " #I:#W#F "

set -gw window-status-current-style "fg=black,bg=red"
set -gw window-status-format " #I:#W#F "
set -gw window-status-separator ""

# Met un titre dans la bordure du panneau
# En haut : le titre coiffe son panneau au lieu de se coller au prompt du panneau du
# dessus. Le dernier panneau n'a alors plus de bordure basse : c'est le fond coloré
# de la barre d'état (status-style) qui crée la séparation.
set -g  pane-border-status top
set -gw pane-border-format '#{?pane_active,#[bg=magenta]#[fg=black]#[bold],#[bg=colour238]#[fg=white]} #P #[nobold]#[bg=default]#[fg=default] Status: #{?#{==:#{@status},0},#[fg=green]✔,#[fg=red]✘}#[fg=default] - #{pane_current_command} : #{b:pane_current_path} '

# Met à jour le titre du programme de terminal
set -g  set-titles  on
set -g  set-titles-string  "#S:#I:#W - \"#T\""

# Mets à jour le nom de la fenêtre


# Set window notifications
set -gw monitor-activity on
set -gw monitor-bell     on
set -gw monitor-silence  0

set -g  visual-activity  off
set -g  visual-bell      off
set -g  visual-silence   off

